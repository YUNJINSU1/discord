{
  "name": "discord-auto-bot-monorepo",
  "version": "1.0.0",
  "description": "Discord Auto Bot - Monorepo with Flask backend and Next.js frontend",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && python main.py --mode web --web-port 5000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "cd backend && pip install -r requirements.txt",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "cd backend && python main.py --mode web --web-port 5000",
    "start:frontend": "cd frontend && npm start",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "docker:dev": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "install": "npm run install:backend && npm run install:frontend",
    "railway:deploy": "railway up",
    "clean": "cd frontend && rm -rf .next node_modules && cd ../backend && find . -name '__pycache__' -exec rm -rf {} +",
    "lint:frontend": "cd frontend && npm run lint",
    "type-check:frontend": "cd frontend && npm run type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "discord",
    "bot",
    "flask",
    "nextjs",
    "monorepo",
    "typescript",
    "python"
  ],
  "author": "Your Name",
  "license": "MIT",
  "workspaces": [
    "frontend"
  ]
}

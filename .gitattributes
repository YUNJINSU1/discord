# Git Line Ending 설정

# 텍스트 파일들
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 환경 파일들
.env* text eol=lf
*.env text eol=lf

# Windows 배치 파일들
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리 파일들
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary

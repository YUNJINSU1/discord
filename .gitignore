# 환경 변수 파일 (토큰 등 민감한 정보 포함)
.env
config/.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs
logs/
*.log
nohup.out

# Config with sensitive data
config/bot_config.json

# Assets (images may be large)
assets/images/*
!assets/images/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
.dockerignore

# 가상환경
venv/
env/
ENV/

# 임시 파일
*.tmp
*.temp

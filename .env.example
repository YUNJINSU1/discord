# ================================
# Discord Bot 설정 (필수)
# ================================
USER_TOKEN=your_discord_user_token_here
CHANNEL_ID=your_target_channel_id_here

# ================================
# 메시지 설정
# ================================
MESSAGE_CONTENT="기본 메시지"
SEND_INTERVAL=1800
IMAGE_PATH=shared/assets/images/sell.png
IS_ENABLED=true

# ================================
# 웹 인터페이스 설정
# ================================
WEB_PORT=8080
DEBUG_MODE=false

# 웹 대시보드 인증 (선택사항, 기본값: admin/password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# ================================
# 서버 포트 설정
# ================================
FLASK_PORT=5000
NEXT_PORT=3000
PORT=8080

# ================================
# 개발 환경 설정
# ================================
NODE_ENV=development
FLASK_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ================================
# Railway 배포용 (프로덕션에서만 사용)
# ================================
RAILWAY_STATIC_URL=
NEXT_TELEMETRY_DISABLED=1
